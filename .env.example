# ============================================================
# CivilCraft — Environment Configuration
# ============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For Vercel deployment, set these in:
#   Vercel Dashboard > Project > Settings > Environment Variables
# ============================================================

# REQUIRED — PlayFab Title ID
# Get this from: https://developer.playfab.com
# Go to: Game Manager > Your Title > Title Settings
# Must be the SAME Title ID used by your Unity mobile game
VITE_PLAYFAB_TITLE_ID=17FA03

# OPTIONAL — Email delivery for bulk user provisioning
# Option 1: Webhook (recommended for production)
# VITE_BULK_PROVISION_WEBHOOK_URL=https://your-server.com/api/send-onboarding

# Option 2: EmailJS (frontend-only, good for testing)
# VITE_EMAILJS_SERVICE_ID=your_service_id
# VITE_EMAILJS_TEMPLATE_ID=your_template_id
# VITE_EMAILJS_PUBLIC_KEY=your_public_key
