VITE_PLAYFAB_TITLE_ID=17FA03
PLAYFAB_SECRET_KEY=
ADMIN_USERS_JSON=
ADMIN_AUTH_ORIGIN=
ADMIN_SESSION_SECRET=

# Private Gallery storage uses the connected Vercel OIDC store with @vercel/blob.
# Vercel supplies rotating OIDC credentials; locally use vercel link / vercel env pull.
BLOB_STORE_ID=
# Legacy email dispatch still requires this token; Gallery does not require it.
BLOB_READ_WRITE_TOKEN=

# Recovery and release email continue using the PlayFab SMTP add-on.
# Required for password recovery: custom Account Recovery template ID. No default fallback.
PLAYFAB_RECOVERY_EMAIL_TEMPLATE_ID=
PLAYFAB_RELEASE_EMAIL_TEMPLATE_ID=
# Authenticates the backend notification worker, never a VITE_ variable.
CRON_SECRET=

# Contact notifications reuse the same PlayFab SMTP provider. Server-only values.
# Recipient is an existing PlayFab account with the admin mailbox as its contact email.
PLAYFAB_CONTACT_ADMIN_PLAYER_ID=
# Generic notification templates linking to /admin/messages and /dashboard/messages.
PLAYFAB_CONTACT_ADMIN_EMAIL_TEMPLATE_ID=
PLAYFAB_CONTACT_REPLY_EMAIL_TEMPLATE_ID=

# Visitor -> Admin notification (Resend)
# Server-only API key and admin recipient email
RESEND_API_KEY=
ADMIN_EMAIL=civil.craft1234@gmail.com
RESEND_FROM="Civil Craft <onboarding@resend.dev>"

# Admin -> Visitor reply delivery (Gmail SMTP via Nodemailer)
# Server-only Gmail SMTP credentials for sending replies to arbitrary visitor email addresses
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_SECURE=true
GMAIL_SMTP_USER=civil.craft1234@gmail.com
# 16-character Google App Password from Google Account Security
GMAIL_SMTP_APP_PASSWORD=

# Public Website URL configuration
# Used for user-facing email buttons & links ("Visit Civil Craft Website ->")
# In production on Vercel, set this to your production domain: https://YOUR-ACTUAL-CIVIL-CRAFT-VERCEL-URL
# During local development, leave unset to default to localhost, or set to your preview/production URL.
PUBLIC_SITE_URL=https://civil-craft.vercel.app

# PayMongo Test Mode Payment System
# Server-only PayMongo API test secret key (sk_test_...)
PAYMONGO_SECRET_KEY=sk_test_...
# Optional public key (pk_test_...)
PAYMONGO_PUBLIC_KEY=pk_test_...
# Server-only PayMongo webhook signing secret from PayMongo Dashboard -> Developers -> Webhooks
PAYMONGO_WEBHOOK_SECRET=
# Explicit application base URL for success/cancel redirects (falls back to PUBLIC_SITE_URL or SITE_URL, never request origin)
PUBLIC_APP_URL=http://localhost:5173
# PlayFab Virtual Currency code for Coins (defaults to CO)
PLAYFAB_COINS_CURRENCY_CODE=CO

# Unified game Coins wallet. Disabled until additive migration and cutover verification.
# These server settings must never be exposed through VITE_ variables.
GAME_WALLET_ENABLED=false
GAME_WALLET_VERIFIED=false
GAME_WALLET_VERIFIED_TITLE_ID=
GAME_WALLET_VERIFIED_CONFIG_SHA256=
GAME_WALLET_LEGACY_HANDLERS_QUIESCED=false
# Legacy PostgreSQL purchase receipts; classic CO remains active until verified v3 cutover.
# Installation is manual: see docs/postgres-currency-setup.md. No automatic fallback.
COIN_RECEIPTS_STORAGE=postgres
# PostgreSQL Coin checkout has its own opt-in gate; legacy flags are not database proof.
COIN_CHECKOUT_ENABLED=false
# Permanent pre-grant claims prevent duplicate classic Coin credit on webhook retries.
# Keep disabled until the selected backend's real setup verification passes.
PLAYFAB_COINS_RECEIPTS_VERIFIED=false
PLAYFAB_COINS_VERIFIED_TITLE_ID=
PLAYFAB_COINS_VERIFIED_CONFIG_SHA256=
# CLI-only disposable account ticket, never expose or commit.
PLAYFAB_COINS_VERIFICATION_PLAYER_TICKET=

# PostgreSQL Diamonds wallet, separate from classic CO and Unity game saves.
# Leave checkout disabled until docs/postgres-currency-setup.md real checks pass.
# These values opt in only in environments where this example is deliberately copied.
PLAYFAB_DIAMONDS_ENABLED=false
PLAYFAB_DIAMONDS_STORAGE=postgres
# Server-only RESTRICTED runtime-role URL, never the database-owner/admin URL.
# Include the provider's TLS settings. Never create a VITE_ version of this secret.
CURRENCY_DATABASE_URL=
# Installation UUID returned by database/currency-schema.sql; not a player ID.
CURRENCY_DATABASE_ID=
# Generated by scripts/verify-currency-database.mjs after real read-only checks.
# Never set these from mocked tests or copy them from a different database/title.
CURRENCY_DATABASE_VERIFIED=false
CURRENCY_DATABASE_VERIFIED_TITLE_ID=
CURRENCY_DATABASE_VERIFIED_CONFIG_SHA256=
# Legacy backend configuration only. Existing Entity Object/Economy v2 wallets
# and Coin receipts require a reviewed migration before switching storage.
# Keep these EMPTY for PostgreSQL and Entity Objects; retain published IDs only
# when deliberately using PLAYFAB_DIAMONDS_STORAGE=economy-v2.
PLAYFAB_DIAMONDS_ITEM_ID=
PLAYFAB_DIAMONDS_RECEIPT_ITEM_ID=
# Verification output binds these attestations to the exact title/storage configuration.
PLAYFAB_DIAMONDS_VERIFIED_TITLE_ID=
PLAYFAB_DIAMONDS_VERIFIED_CONFIG_SHA256=
PLAYFAB_DIAMONDS_BOOTSTRAP_VERIFIED=false
PLAYFAB_DIAMONDS_PLAYER_WRITES_DENIED=false
# Real-title full-size (8192-byte) save/readback/owned-marker-cleanup proof required.
# Old single-receipt verification fingerprints are no longer accepted.
PLAYFAB_DIAMONDS_CAPACITY_VERIFIED=false
# Only for the opt-in verification script; never expose or commit a player ticket.
PLAYFAB_DIAMONDS_VERIFICATION_PLAYER_TICKET=
