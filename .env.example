VITE_PLAYFAB_TITLE_ID=17FA03
PLAYFAB_SECRET_KEY=
ADMIN_USERS_JSON=
ADMIN_AUTH_ORIGIN=
ADMIN_SESSION_SECRET=

# Private Gallery storage uses the connected Vercel OIDC store with @vercel/blob.
# Vercel supplies rotating OIDC credentials; locally use vercel link / vercel env pull.
BLOB_STORE_ID=
# Legacy email dispatch still requires this token; Gallery does not require it.
BLOB_READ_WRITE_TOKEN=

# Recovery and release email continue using the PlayFab SMTP add-on.
# Required for password recovery: custom Account Recovery template ID. No default fallback.
PLAYFAB_RECOVERY_EMAIL_TEMPLATE_ID=
PLAYFAB_RELEASE_EMAIL_TEMPLATE_ID=
# Authenticates the backend notification worker, never a VITE_ variable.
CRON_SECRET=

# Contact notifications reuse the same PlayFab SMTP provider. Server-only values.
# Recipient is an existing PlayFab account with the admin mailbox as its contact email.
PLAYFAB_CONTACT_ADMIN_PLAYER_ID=
# Generic notification templates linking to /admin/messages and /dashboard/messages.
PLAYFAB_CONTACT_ADMIN_EMAIL_TEMPLATE_ID=
PLAYFAB_CONTACT_REPLY_EMAIL_TEMPLATE_ID=

# Rich contact email: reuse the SAME provider/credentials configured in PlayFab.
# Server-only; never prefix with VITE_. SMTP_FROM is a bare provider-approved email.
# All empty preserves generic PlayFab templates. Partial configuration fails safely.
# Port 465 uses implicit TLS; other ports (default 587) require STARTTLS.
# Dashboard links use existing ADMIN_AUTH_ORIGIN (HTTPS).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Resend branded email delivery (server-only; never prefix with VITE_)
# When RESEND_API_KEY is configured, contact notifications and admin replies are delivered via Resend.
RESEND_API_KEY=
ADMIN_EMAIL=
# Sender address: optional. Defaults to "Civil Craft <onboarding@resend.dev>" for testing if unset.
RESEND_FROM="Civil Craft <onboarding@resend.dev>"
